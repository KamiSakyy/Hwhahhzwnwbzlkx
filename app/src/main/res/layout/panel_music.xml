<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="2dp"
    android:paddingRight="14dp"
    android:paddingBottom="6dp">

    <com.kamisakyy.cutpro.AutoFitTextView
        android:id="@+id/musicName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/dim"
        android:textSize="10.5sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.kamisakyy.cutpro.AutoFitTextView
                android:id="@+id/btnMusicVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:drawableLeft="@drawable/ic_wave"
                android:drawablePadding="6dp"
                android:drawableTint="@color/accent"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="30dp"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="13dp"
                android:paddingBottom="7dp"
                android:text="Звук из видео"
                android:textColor="@color/text"
                android:textSize="10.5sp" />

            <com.kamisakyy.cutpro.AutoFitTextView
                android:id="@+id/btnMusicFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="30dp"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="12dp"
                android:paddingBottom="7dp"
                android:text="Аудиофайл"
                android:textColor="@color/text"
                android:textSize="10.5sp" />

            <com.kamisakyy.cutpro.AutoFitTextView
                android:id="@+id/btnMusicClip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="30dp"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="12dp"
                android:paddingBottom="7dp"
                android:text="Из клипа"
                android:textColor="@color/text"
                android:textSize="10.5sp" />

            <com.kamisakyy.cutpro.AutoFitTextView
                android:id="@+id/btnMusicRemove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_chip_danger"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="30dp"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="12dp"
                android:paddingBottom="7dp"
                android:text="Убрать"
                android:textColor="@color/danger"
                android:textSize="10.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/SectionLabel"
            android:layout_width="54dp"
            android:text="ГРОМК." />

        <SeekBar
            android:id="@+id/musicVolume"
            style="@style/PanelSlider"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:max="200"
            android:progress="55" />

        <com.kamisakyy.cutpro.AutoFitTextView
            android:id="@+id/musicVolumeValue"
            style="@style/ValueText"
            android:layout_width="46dp"
            android:gravity="right"
            android:text="55%"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
