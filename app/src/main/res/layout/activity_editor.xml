<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:background="@drawable/bg_topbar"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="10dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/app_name"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.kamisakyy.cutpro.AutoFitTextView
                    android:id="@+id/projectTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/metaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dim2"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnUndo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:padding="7dp"
                android:src="@drawable/ic_undo"
                android:tint="@color/dim" />

            <ImageView
                android:id="@+id/btnRedo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:padding="7dp"
                android:src="@drawable/ic_redo"
                android:tint="@color/dim" />

            <LinearLayout
                android:id="@+id/btnExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_export_gradient"
                android:gravity="center"
                android:minHeight="34dp"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="7dp"
                android:paddingRight="13dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_export"
                    android:tint="@color/on_accent" />

                <com.kamisakyy.cutpro.AutoFitTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="Экспорт"
                    android:textColor="@color/on_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Preview -->
        <FrameLayout
            android:id="@+id/previewHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp">

            <com.kamisakyy.cutpro.AspectFrameLayout
                android:id="@+id/previewBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_preview_card"
                android:clipToOutline="true">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:show_buffering="never"
                    app:use_controller="false" />

                <FrameLayout
                    android:id="@+id/textOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/centerPlay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_solid"
                    android:contentDescription="@string/app_name"
                    android:padding="14dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text" />
            </com.kamisakyy.cutpro.AspectFrameLayout>

            <TextView
                android:id="@+id/emptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Импортируйте видео, чтобы начать монтаж"
                android:textColor="@color/dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_marginLeft="20dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_time_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp">

                <com.kamisakyy.cutpro.AutoFitTextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="@color/text"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom sheet: timeline + tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_sheet"
            android:orientation="vertical">

            <View
                android:layout_width="34dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_handle" />

            <com.kamisakyy.cutpro.TimelineView
                android:id="@+id/timeline"
                android:layout_width="match_parent"
                android:layout_height="104dp" />

            <FrameLayout
                android:id="@+id/panelHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:overScrollMode="never"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/toolRail"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
