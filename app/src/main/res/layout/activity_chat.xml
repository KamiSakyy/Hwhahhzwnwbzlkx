<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/chatToolbar"
        style="@style/ARI.Toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bg_secondary" android:gravity="center"
        android:padding="5dp" android:text="🔐 Сквозное шифрование · Double Ratchet"
        android:textColor="@color/text_secondary" android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/msgList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="8dp" android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bg_secondary" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="8dp">

        <ImageButton
            android:id="@+id/attachBtn"
            android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Прикрепить" android:src="@android:drawable/ic_menu_add" />

        <EditText
            android:id="@+id/msgInput"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/input_bg"
            android:hint="Сообщение" android:textColorHint="@color/text_secondary"
            android:inputType="textMultiLine|textCapSentences" android:maxLines="4"
            android:padding="12dp" android:textColor="@color/text_primary" android:textSize="16sp" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/send_bg"
            android:contentDescription="Отправить" android:src="@android:drawable/ic_menu_send" />
    </LinearLayout>
</LinearLayout>
