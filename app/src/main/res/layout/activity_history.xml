<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="История" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
<ImageButton android:id="@+id/btnRefreshH" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle" android:padding="12dp" android:src="@drawable/ic_refresh" app:tint="#E5E5E5"/>
</LinearLayout>
<TextView android:id="@+id/tvHistStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="6dp" android:textColor="#A3A3A3" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="14dp" android:background="@drawable/segmented" android:orientation="horizontal" android:padding="3dp">
<com.google.android.material.button.MaterialButton android:id="@+id/fAll" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Все"/>
<com.google.android.material.button.MaterialButton android:id="@+id/fIn" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Входящие"/>
<com.google.android.material.button.MaterialButton android:id="@+id/fOut" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Исходящие"/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:id="@+id/histList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="10dp"/></ScrollView>
<com.google.android.material.button.MaterialButton android:id="@+id/btnExplorer" style="@style/TonalBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="14dp" android:text="Открыть в обозревателе блоков" app:icon="@drawable/ic_open"/>
</LinearLayout>
<include layout="@layout/include_bottom_nav"/>
</LinearLayout>
