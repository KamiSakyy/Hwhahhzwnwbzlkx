<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:orientation="vertical">

<!-- Список диалогов -->
<LinearLayout android:id="@+id/chatsView" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#0A0A0A" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Сообщения" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
<ImageButton android:id="@+id/btnRefresh" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle" android:padding="12dp" android:src="@drawable/ic_refresh" app:tint="#E5E5E5"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sepolia Testnet · переписка хранится в блокчейне" android:textColor="#A3A3A3" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
<EditText android:id="@+id/etPeer" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/input_pill" android:hint="Адрес друга 0x…" android:paddingStart="18dp" android:paddingEnd="12dp" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="13sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnNewChat" style="@style/PrimaryBtn" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="10dp" android:text="Написать"/>
</LinearLayout>
<TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#A3A3A3" android:textIsSelectable="true" android:textSize="12sp"/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:id="@+id/chatsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp"/></ScrollView>
<include layout="@layout/include_bottom_nav"/>
</LinearLayout>

<!-- Один диалог -->
<LinearLayout android:id="@+id/chatView" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="#0A0A0A" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="10dp">
<ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:rotation="180" android:src="@drawable/ic_arrow_forward" app:tint="#FFFFFF"/>
<TextView android:id="@+id/tvAvatar" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="?" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/tvPeerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" android:text="0x…" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvEncState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sepolia Testnet" android:textColor="#A3A3A3" android:textSize="12sp"/>
</LinearLayout>
<ImageButton android:id="@+id/btnLock" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:src="@drawable/ic_lock" app:tint="#E5E5E5"/>
</LinearLayout>
<ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:id="@+id/msgList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="8dp"/></ScrollView>
<TextView android:id="@+id/tvChatStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="4dp" android:textColor="#A3A3A3" android:textIsSelectable="true" android:textSize="12sp"/>
<TextView android:id="@+id/tvFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="6dp" android:textColor="#A3A3A3" android:textSize="12sp"/>
<TextView android:id="@+id/tvAmountChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginBottom="8dp" android:background="@drawable/segmented" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textColor="#E5E5E5" android:textSize="12sp" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#0A0A0A" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="10dp">
<ImageButton android:id="@+id/btnAttach" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_attach" app:tint="#A3A3A3"/>
<EditText android:id="@+id/etMsg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_pill" android:hint="Сообщение" android:maxLines="4" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="13dp" android:paddingBottom="13dp" android:textColor="#FFFFFF" android:textColorHint="#737373" android:textSize="15sp"/>
<ImageButton android:id="@+id/btnSendMsg" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/btn_primary" android:padding="13dp" android:src="@drawable/ic_send" app:tint="#000000"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
