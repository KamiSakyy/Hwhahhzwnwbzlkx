<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:orientation="vertical">

<!-- ===== Список диалогов ===== -->
<LinearLayout android:id="@+id/chatsView" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="8dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Сообщения" android:textColor="#FAFAFA" android:textSize="26sp" android:textStyle="bold"/>
<ImageButton android:id="@+id/btnRefresh" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle" android:padding="12dp" android:src="@drawable/ic_refresh" app:tint="#FAFAFA"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="Sepolia Testnet · переписка хранится в блокчейне" android:textColor="#71717A" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp">
<com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPeer" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Адрес друга 0x…" android:textColor="#FFF" android:textSize="13sp"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnNewChat" style="@style/PrimaryBtn" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="10dp" android:text="Написать"/>
</LinearLayout>
<TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:textColor="#71717A" android:textSize="12sp" android:textIsSelectable="true"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:id="@+id/chatsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp"/></ScrollView>
</LinearLayout>

<!-- ===== Один диалог ===== -->
<LinearLayout android:id="@+id/chatView" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="16dp">
<ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:rotation="180" android:src="@drawable/ic_arrow_forward" app:tint="#FAFAFA"/>
<TextView android:id="@+id/tvAvatar" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="?" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
<TextView android:id="@+id/tvPeerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" android:text="0x…" android:textColor="#FAFAFA" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sepolia Testnet" android:textColor="#71717A" android:textSize="12sp"/>
</LinearLayout>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#16161C"/>
<ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:id="@+id/msgList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"/></ScrollView>
<TextView android:id="@+id/tvChatStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="4dp" android:textColor="#71717A" android:textSize="12sp" android:textIsSelectable="true"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="4dp">
<com.google.android.material.button.MaterialButton android:id="@+id/btnPhoto" style="@style/GhostBtn" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Фото" android:textSize="11sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnVideo" style="@style/GhostBtn" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Видео" android:textSize="11sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnVoice" style="@style/GhostBtn" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Голос" android:textSize="11sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCircle" style="@style/GhostBtn" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Кружок" android:textSize="11sp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
<com.google.android.material.textfield.TextInputLayout android:layout_width="92dp" android:layout_height="wrap_content" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etAmt" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Сумма" android:inputType="numberDecimal" android:text="0" android:textColor="#FFF" android:textSize="13sp"/></com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginEnd="8dp" android:text="SepoliaETH" android:textColor="#71717A" android:textSize="10sp"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etMsg" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Сообщение" android:textColor="#FFF" android:maxLines="4"/></com.google.android.material.textfield.TextInputLayout>
<ImageButton android:id="@+id/btnSendMsg" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:background="@drawable/btn_primary" android:padding="14dp" android:src="@drawable/ic_send"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
