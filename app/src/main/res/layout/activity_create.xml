<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Секретная фраза" style="@style/H1"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Запишите 12 слов на бумаге. Кто знает фразу — владеет деньгами. Никому не показывайте!" style="@style/Sub"/>
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="#16162A" app:cardCornerRadius="20dp"><TextView android:id="@+id/tvMnemonic" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:textColor="#FFFFFF" android:textSize="18sp" android:lineSpacingMultiplier="1.5"/></androidx.cardview.widget.CardView>
<Button android:id="@+id/btnCopy" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" style="@style/BtnOutline" android:text=" Скопировать фразу"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Придумайте PIN (мин. 4 цифры)" android:inputType="numberPassword" android:textColor="#FFF"/></com.google.android.material.textfield.TextInputLayout>
<CheckBox android:id="@+id/cbSaved" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Я записал(а) фразу и храню её в безопасности" android:textColor="#FFFFFF"/>
<Button android:id="@+id/btnDone" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="18dp" android:text="Открыть кошелёк " android:background="@drawable/btn_primary" android:textColor="#FFFFFF"/>
</LinearLayout></ScrollView>
