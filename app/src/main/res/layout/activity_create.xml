<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Секретная фраза" style="@style/H1"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Запишите 12 слов на бумаге и храните офлайн. Кто знает фразу — владеет средствами. Никому её не показывайте." style="@style/Sub"/>
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" app:cardBackgroundColor="#121212" app:cardCornerRadius="24dp"><TextView android:id="@+id/tvMnemonic" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingMultiplier="1.6" android:padding="22dp" android:textColor="#FFFFFF" android:textSize="18sp"/></androidx.cardview.widget.CardView>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCopy" style="@style/TonalBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="Скопировать фразу" app:icon="@drawable/ic_copy"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="PIN для входа, минимум 4 цифры" android:inputType="numberPassword" android:textColor="#FFFFFF"/></com.google.android.material.textfield.TextInputLayout>
<CheckBox android:id="@+id/cbSaved" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Я записал фразу и храню её в безопасности" android:textColor="#E5E5E5"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnDone" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:text="Открыть кошелёк"/>
</LinearLayout></ScrollView>
