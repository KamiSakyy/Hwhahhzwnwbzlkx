<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:gravity="center" android:orientation="vertical" android:padding="28dp">
<ImageView android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/logo_box" android:padding="17dp" android:src="@drawable/ic_logo" app:tint="#FFFFFF"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="С возвращением" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Введите PIN, чтобы открыть кошелёк" android:textColor="#A3A3A3" android:textSize="14sp"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:hint="PIN" android:inputType="numberPassword" android:textColor="#FFFFFF" android:textSize="20sp"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnUnlock" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="16dp" android:text="Разблокировать"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnBio" style="@style/TonalBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="По отпечатку или лицу" app:icon="@drawable/ic_fingerprint"/>
</LinearLayout>
