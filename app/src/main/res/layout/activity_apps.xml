<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="13dp"
        android:paddingLeft="12dp"
        android:paddingRight="14dp"
        android:paddingTop="15dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:contentDescription="@string/apps_back"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="@string/apps_title"
            android:textColor="@color/text_hi"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_done"
            style="@style/TMiniBtn"
            android:text="@string/apps_done" />
    </LinearLayout>

    <View style="@style/TDivider" />

    <EditText
        android:id="@+id/app_search"
        style="@style/TInput"
        android:layout_margin="12dp"
        android:hint="@string/apps_search_hint"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/apps_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/apps_loading"
            android:textColor="@color/text_low"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_select_all"
            style="@style/TMiniBtn"
            android:text="@string/btn_select_all" />

        <TextView
            android:id="@+id/btn_select_none"
            style="@style/TMiniBtn"
            android:layout_marginLeft="6dp"
            android:text="@string/btn_select_none" />

        <TextView
            android:id="@+id/btn_invert"
            style="@style/TMiniBtn"
            android:layout_marginLeft="6dp"
            android:text="@string/btn_invert" />
    </LinearLayout>

    <ListView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="12dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:scrollbars="none" />

</LinearLayout>
