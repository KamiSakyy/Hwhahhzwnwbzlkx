<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отправить" style="@style/H1"/>
<TextView android:id="@+id/tvBal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Sub"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/card_plain" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.1" android:text="ПОЛУЧАТЕЛЬ" android:textColor="#737373" android:textSize="11sp"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etTo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Адрес 0x…" android:textColor="#FFFFFF" android:textSize="14sp"/></com.google.android.material.textfield.TextInputLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.1" android:text="СУММА" android:textColor="#737373" android:textSize="11sp"/>
<TextView android:id="@+id/btnMax" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/segmented" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="МАКС" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
</LinearLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etAmt" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0.0" android:inputType="numberDecimal" android:textColor="#FFFFFF" android:textSize="20sp"/></com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSend" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="22dp" android:text="Отправить"/>
<ProgressBar android:id="@+id/prog" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="18dp" android:indeterminateTint="#FFFFFF" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCopy" style="@style/TonalBtn" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:text="Скопировать хэш / детали" android:visibility="gone" app:icon="@drawable/ic_copy"/>
<TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_plain" android:lineSpacingMultiplier="1.4" android:padding="16dp" android:textColor="#E5E5E5" android:textIsSelectable="true" android:textSize="13sp"/>
</LinearLayout></ScrollView>
