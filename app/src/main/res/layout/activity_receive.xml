<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Получить" style="@style/H1"/>
<TextView android:id="@+id/tvNet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" style="@style/Sub"/>
<androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp"><ImageView android:id="@+id/ivQr" android:layout_width="260dp" android:layout_height="260dp" android:padding="14dp"/></androidx.cardview.widget.CardView>
<TextView android:id="@+id/tvAddr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="#FFF" android:background="@drawable/bg_chip" android:padding="14dp" android:gravity="center" android:textSize="12sp"/>
<Button android:id="@+id/btnCopy" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="📋 Копировать адрес" android:background="@drawable/btn_primary" android:textColor="#FFFFFF"/>
<Button android:id="@+id/btnShare" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" style="@style/BtnOutline" android:text="↗ Поделиться"/>
</LinearLayout>
