<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Получить" style="@style/H1"/>
<TextView android:id="@+id/tvNet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Sub"/>
<androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="28dp"><ImageView android:id="@+id/ivQr" android:layout_width="264dp" android:layout_height="264dp" android:padding="16dp"/></androidx.cardview.widget.CardView>
<TextView android:id="@+id/tvAddr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_chip" android:gravity="center" android:padding="16dp" android:textColor="#E5E5E5" android:textSize="12sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCopy" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:text="Скопировать адрес" app:icon="@drawable/ic_copy"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnShare" style="@style/TonalBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Поделиться" app:icon="@drawable/ic_share"/>
</LinearLayout>
