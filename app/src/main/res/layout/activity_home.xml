<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◆ NOVA WALLET" android:textColor="#FFF" android:textStyle="bold" android:textSize="17sp"/><Spinner android:id="@+id/spNet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
<Button android:id="@+id/chipEvm" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="EVM" android:backgroundTint="#7C4DFF"/><Button android:id="@+id/chipBtc" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Bitcoin" android:backgroundTint="#2A2A44"/><Button android:id="@+id/chipSol" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Solana" android:backgroundTint="#2A2A44"/></LinearLayout>
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="#24124D" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/tvNetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sepolia Testnet" android:textColor="#C9B8FF" android:textSize="13sp"/>
<TextView android:id="@+id/tvBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0.00" android:textColor="#FFF" android:textSize="38sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvFiat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="≈ $0.00" android:textColor="#C9B8FF"/>
<TextView android:id="@+id/tvAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0x…" android:textColor="#FFF" android:background="@drawable/bg_chip" android:padding="10dp" android:textSize="12sp"/>
</LinearLayout></androidx.cardview.widget.CardView>
<GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:columnCount="4">
<Button android:id="@+id/btnSend" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="↗ Отправить"/><Button android:id="@+id/btnReceive" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="↙ Получить"/><Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="📷 Скан"/><Button android:id="@+id/btnSwap" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="⇄ Обмен"/>
<Button android:id="@+id/btnCreateToken" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="🪙 Токен"/><Button android:id="@+id/btnBrowser" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="🌐 DeFi"/><Button android:id="@+id/btnNft" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="🖼 NFT"/><Button android:id="@+id/btnMore" android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1" android:text="⚙ Ещё"/>
</GridLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Активы" style="@style/H2"/><Button android:id="@+id/btnAddToken" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/BtnOutline" android:text="+ Токен"/></LinearLayout>
<LinearLayout android:id="@+id/tokenList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"/>
<Button android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" style="@style/BtnOutline" android:text="📜 История в обозревателе блоков"/>
</LinearLayout></ScrollView>
