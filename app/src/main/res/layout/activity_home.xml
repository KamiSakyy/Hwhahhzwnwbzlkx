<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:scrollbars="none">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="32dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/logo_box" android:padding="9dp" android:src="@drawable/ic_logo" app:tint="#FFFFFF"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nova" android:textColor="#FAFAFA" android:textSize="17sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Кошелёк" android:textColor="#71717A" android:textSize="12sp"/>
</LinearLayout>
<Spinner android:id="@+id/spNet" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/segmented" android:paddingStart="10dp" android:paddingEnd="4dp"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="20dp" android:background="@drawable/segmented" android:orientation="horizontal" android:padding="3dp">
<com.google.android.material.button.MaterialButton android:id="@+id/chipEvm" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="EVM"/>
<com.google.android.material.button.MaterialButton android:id="@+id/chipBtc" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Bitcoin"/>
<com.google.android.material.button.MaterialButton android:id="@+id/chipSol" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Solana"/>
</LinearLayout>

<LinearLayout android:id="@+id/balanceCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_main" android:orientation="vertical" android:padding="24dp">
<TextView android:id="@+id/tvNetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sepolia Testnet" android:textColor="#71717A" android:textSize="13sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Баланс" android:textColor="#52525B" android:textSize="12sp"/>
<TextView android:id="@+id/tvBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="38sp" android:autoSizeTextType="uniform" android:text="0" android:textColor="#FAFAFA" android:textSize="38sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvFiat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="—" android:textColor="#71717A" android:textSize="13sp"/>
<LinearLayout android:id="@+id/addressRow" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" android:background="@drawable/bg_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="8dp">
<TextView android:id="@+id/tvAddress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="middle" android:maxLines="1" android:text="0x0000…0000" android:textColor="#D4D4D8" android:textSize="13sp"/>
<ImageView android:layout_width="36dp" android:layout_height="36dp" android:padding="9dp" android:src="@drawable/ic_copy" app:tint="#A1A1AA"/>
</LinearLayout>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/btnSend" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_send" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Отправить" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnReceive" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_download" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Получить" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnScan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_qr" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Сканер" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnSwap" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_swap" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Обмен" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/btnCreateToken" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_token" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Токен" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnBrowser" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_public" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="DeFi" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnNft" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_image" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="NFT" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnMore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_more" app:tint="#FAFAFA"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Ещё" android:textColor="#D4D4D8" android:textSize="12sp"/></LinearLayout>
</LinearLayout>

<com.google.android.material.button.MaterialButton android:id="@+id/btnChat" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:text="Мессенджер Sepolia" app:icon="@drawable/ic_chat"/>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Активы" android:textColor="#FAFAFA" android:textSize="17sp" android:textStyle="bold"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnAddToken" style="@style/GhostBtn" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Добавить" android:textColor="#D4D4D8" app:icon="@drawable/ic_add" app:iconTint="#D4D4D8"/>
</LinearLayout>
<LinearLayout android:id="@+id/tokenList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>

<TextView android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_chip" android:drawableStart="@drawable/ic_history" android:drawablePadding="10dp" android:gravity="center" android:text="История транзакций" android:textColor="#A1A1AA" android:textSize="13sp"/>

</LinearLayout>
</ScrollView>
