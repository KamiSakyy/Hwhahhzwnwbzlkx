<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:orientation="vertical">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="20dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
<ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/logo_box" android:padding="9dp" android:src="@drawable/ic_logo" app:tint="#FFFFFF"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nova" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Кошелёк" android:textColor="#A3A3A3" android:textSize="12sp"/>
</LinearLayout>
<Spinner android:id="@+id/spNet" android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/segmented" android:paddingStart="10dp"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="18dp" android:background="@drawable/segmented" android:orientation="horizontal" android:padding="3dp">
<com.google.android.material.button.MaterialButton android:id="@+id/chipEvm" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="EVM"/>
<com.google.android.material.button.MaterialButton android:id="@+id/chipBtc" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Bitcoin"/>
<com.google.android.material.button.MaterialButton android:id="@+id/chipSol" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Solana"/>
</LinearLayout>

<LinearLayout android:id="@+id/balanceCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_main" android:orientation="vertical" android:padding="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:id="@+id/tvNetName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sepolia Testnet" android:textColor="#A3A3A3" android:textSize="13sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/segmented" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Активен" android:textColor="#FFFFFF" android:textSize="11sp"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:letterSpacing="0.12" android:text="БАЛАНС" android:textColor="#737373" android:textSize="11sp"/>
<TextView android:id="@+id/tvBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:autoSizeMaxTextSize="40sp" android:autoSizeMinTextSize="22sp" android:autoSizeTextType="uniform" android:maxLines="1" android:text="0" android:textColor="#FFFFFF" android:textSize="40sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvFiat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="—" android:textColor="#A3A3A3" android:textSize="13sp"/>
<LinearLayout android:id="@+id/addressRow" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="22dp" android:background="@drawable/bg_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="8dp">
<TextView android:id="@+id/tvAddress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="middle" android:maxLines="1" android:text="0x0000…0000" android:textColor="#E5E5E5" android:textSize="13sp"/>
<ImageView android:layout_width="36dp" android:layout_height="36dp" android:padding="9dp" android:src="@drawable/ic_copy" app:tint="#A3A3A3"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Нажмите адрес, чтобы скопировать" android:textColor="#737373" android:textSize="11sp"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/btnSend" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/btn_primary" android:padding="16dp" android:src="@drawable/ic_send" app:tint="#000000"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Отправить" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnReceive" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_download" app:tint="#E5E5E5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Получить" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnScan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_qr" app:tint="#E5E5E5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Сканер" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnSwap" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_swap" app:tint="#E5E5E5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Обмен" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/btnCreateToken" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_token" app:tint="#E5E5E5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Токен" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnBrowser" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_public" app:tint="#E5E5E5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="DeFi" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnNft" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_image" app:tint="#E5E5E5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="NFT" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/btnMore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless"><ImageView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle" android:padding="16dp" android:src="@drawable/ic_more" app:tint="#E5E5E5"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="1" android:text="Ещё" android:textColor="#E5E5E5" android:textSize="12sp"/></LinearLayout>
</LinearLayout>

<LinearLayout android:id="@+id/btnChat" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="26dp" android:background="@drawable/card_plain" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="14dp">
<ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_circle" android:padding="10dp" android:src="@drawable/ic_chat" app:tint="#E5E5E5"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Мессенджер Sepolia" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сообщения и переводы в блокчейне" android:textColor="#A3A3A3" android:textSize="12sp"/>
</LinearLayout>
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow_forward" app:tint="#737373"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Активы" style="@style/H2"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnAddToken" style="@style/TonalBtn" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Добавить" app:icon="@drawable/ic_add"/>
</LinearLayout>
<LinearLayout android:id="@+id/tokenList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
<TextView android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:background="@drawable/card_plain" android:drawableStart="@drawable/ic_history" android:drawablePadding="10dp" android:gravity="center" android:text="Вся история транзакций" android:textColor="#A3A3A3" android:textSize="13sp"/>

</LinearLayout></ScrollView>
<include layout="@layout/include_bottom_nav"/>
</LinearLayout>
