<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:scrollbars="none"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="28dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/logo_box" android:padding="11dp" android:src="@drawable/ic_logo"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOVA" android:textColor="#FFF" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Web3 Wallet" android:textColor="#6E6E8A" android:textSize="12sp"/></LinearLayout>
<Spinner android:id="@+id/spNet" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_chip" android:paddingStart="8dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="18dp" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/chipEvm" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="EVM"/><com.google.android.material.button.MaterialButton android:id="@+id/chipBtc" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Bitcoin"/><com.google.android.material.button.MaterialButton android:id="@+id/chipSol" style="@style/ChipBtn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Solana"/></LinearLayout>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="#101018" app:cardCornerRadius="28dp" app:strokeColor="#2A2A44" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_main" android:orientation="vertical" android:padding="22dp">
<TextView android:id="@+id/tvNetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sepolia Testnet" android:textColor="#8F8FB8" android:textSize="12sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="БАЛАНС" android:textColor="#6E6E8A" android:textSize="11sp" android:letterSpacing="0.14"/>
<TextView android:id="@+id/tvBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0.00" android:textColor="#FFF" android:textSize="40sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvFiat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="$0.00" android:textColor="#00E5FF" android:textSize="14sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingTop="6dp" android:paddingBottom="6dp"><TextView android:id="@+id/tvAddress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0x…" android:textColor="#E8E8FF" android:textSize="12sp"/><ImageView android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:src="@drawable/ic_copy"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Адрес — копирование, баланс — обновление" android:textColor="#55556F" android:textSize="11sp"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:columnCount="4">
<com.google.android.material.button.MaterialButton android:id="@+id/btnSend" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Отправить" app:icon="@drawable/ic_send"/><com.google.android.material.button.MaterialButton android:id="@+id/btnReceive" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Получить" app:icon="@drawable/ic_download"/><com.google.android.material.button.MaterialButton android:id="@+id/btnScan" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Скан QR" app:icon="@drawable/ic_qr"/><com.google.android.material.button.MaterialButton android:id="@+id/btnSwap" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Обмен" app:icon="@drawable/ic_swap"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCreateToken" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Свой токен" app:icon="@drawable/ic_token"/><com.google.android.material.button.MaterialButton android:id="@+id/btnBrowser" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="DeFi" app:icon="@drawable/ic_public"/><com.google.android.material.button.MaterialButton android:id="@+id/btnNft" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="NFT" app:icon="@drawable/ic_image"/><com.google.android.material.button.MaterialButton android:id="@+id/btnMore" style="@style/ActionBtn" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Ещё" app:icon="@drawable/ic_more"/>
</GridLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnChat" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="10dp" android:text="Криптомессенджер Sepolia" android:background="@drawable/btn_primary" android:textColor="#FFF" app:icon="@drawable/ic_chat" app:iconTint="#FFFFFF"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Сообщения записываются в поле data транзакций Sepolia" android:textColor="#44445E" android:textSize="11sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Активы" android:textColor="#FFF" android:textSize="19sp" android:textStyle="bold"/><com.google.android.material.button.MaterialButton android:id="@+id/btnAddToken" style="@style/GhostBtn" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Добавить" android:textColor="#7DD7FF" app:icon="@drawable/ic_add" app:iconTint="#7DD7FF"/></LinearLayout>
<LinearLayout android:id="@+id/tokenList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnHistory" style="@style/GhostBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:text="История транзакций" android:textColor="#C9C9E8" app:icon="@drawable/ic_history" app:iconTint="#C9C9E8"/>
</LinearLayout></ScrollView>
