<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:scrollbars="none"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="28dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/logo_box" android:gravity="center" android:text="◆" android:textColor="#FFF" android:textSize="20sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOVA" android:textColor="#FFF" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Web3 Wallet" android:textColor="#6E6E8A" android:textSize="12sp"/></LinearLayout>
<Spinner android:id="@+id/spNet" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_chip" android:paddingStart="8dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="18dp" android:orientation="horizontal">
<Button android:id="@+id/chipEvm" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="EVM" android:textSize="13sp" android:background="@drawable/btn_primary" android:textColor="#FFF"/><Button android:id="@+id/chipBtc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Bitcoin" android:textSize="13sp" android:background="@drawable/btn_action" android:textColor="#DDD"/><Button android:id="@+id/chipSol" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Solana" android:textSize="13sp" android:background="@drawable/btn_action" android:textColor="#DDD"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_main" android:orientation="vertical" android:padding="22dp">
<TextView android:id="@+id/tvNetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sepolia Testnet" android:textColor="#8F8FB8" android:textSize="12sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="БАЛАНС" android:textColor="#6E6E8A" android:textSize="11sp" android:letterSpacing="0.12"/>
<TextView android:id="@+id/tvBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0.00" android:textColor="#FFF" android:textSize="40sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvFiat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="≈ $0.00" android:textColor="#00E5FF" android:textSize="14sp"/>
<TextView android:id="@+id/tvAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="0x…" android:textColor="#E8E8FF" android:background="@drawable/bg_chip" android:padding="12dp" android:textSize="12sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Нажмите на адрес, чтобы скопировать • на баланс — обновить" android:textColor="#55556F" android:textSize="11sp"/>
</LinearLayout>
<GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:columnCount="4">
<Button android:id="@+id/btnSend" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#FFF" android:textSize="11sp" android:text="↗\nОтправить"/><Button android:id="@+id/btnReceive" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#FFF" android:textSize="11sp" android:text="↙\nПолучить"/><Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#FFF" android:textSize="11sp" android:text="⌗\nСкан QR"/><Button android:id="@+id/btnSwap" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#FFF" android:textSize="11sp" android:text="⇄\nОбмен"/>
<Button android:id="@+id/btnCreateToken" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#7DD7FF" android:textSize="11sp" android:text="◈\nСвой токен"/><Button android:id="@+id/btnBrowser" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#FFF" android:textSize="11sp" android:text="◎\nDeFi"/><Button android:id="@+id/btnNft" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#FFF" android:textSize="11sp" android:text="▦\nNFT"/><Button android:id="@+id/btnMore" android:layout_width="0dp" android:layout_height="78dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="#FFF" android:textSize="11sp" android:text="•••\nЕщё"/>
</GridLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Активы" android:textColor="#FFF" android:textSize="19sp" android:textStyle="bold"/><Button android:id="@+id/btnAddToken" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/btn_ghost" android:textColor="#7DD7FF" android:textSize="12sp" android:text="+ Добавить"/></LinearLayout>
<LinearLayout android:id="@+id/tokenList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
<Button android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/btn_ghost" android:textColor="#C9C9E8" android:text="История транзакций ↗"/>
</LinearLayout></ScrollView>
