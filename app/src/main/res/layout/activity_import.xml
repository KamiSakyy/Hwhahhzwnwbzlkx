<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Импорт кошелька" style="@style/H1"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Введите секретную фразу из 12 или 24 слов либо приватный ключ EVM, начинающийся с 0x." style="@style/Sub"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etSecret" android:layout_width="match_parent" android:layout_height="150dp" android:gravity="top" android:hint="Фраза или приватный ключ" android:textColor="#FFFFFF"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="PIN для входа, минимум 4 цифры" android:inputType="numberPassword" android:textColor="#FFFFFF"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnImport" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="22dp" android:text="Импортировать"/>
</LinearLayout></ScrollView>
