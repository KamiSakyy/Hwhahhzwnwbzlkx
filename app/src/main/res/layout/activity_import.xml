<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Импорт кошелька" style="@style/H1"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Введите фразу из 12/24 слов ИЛИ приватный ключ EVM (0x…)" style="@style/Sub"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etSecret" android:layout_width="match_parent" android:layout_height="140dp" android:gravity="top" android:hint="фраза или приватный ключ" android:textColor="#FFF"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="PIN для входа (мин. 4)" android:inputType="numberPassword" android:textColor="#FFF"/></com.google.android.material.textfield.TextInputLayout>
<Button android:id="@+id/btnImport" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:text="Импортировать" android:background="@drawable/btn_primary" android:textColor="#0A0A0C"/>
</LinearLayout></ScrollView>
