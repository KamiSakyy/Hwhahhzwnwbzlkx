<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#F4F6FA" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="THEME STUDIO  /  2026" android:textColor="#2586BF" android:textSize="12sp" android:letterSpacing="0.12" android:padding="16dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ваша тема. Ваш стиль." android:textStyle="bold" android:textSize="26sp" android:textColor="#18293B" android:paddingLeft="16dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Коснитесь элемента, чтобы изменить его цвет" android:textColor="#607387" android:padding="16dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/chat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Чат"/><Button android:id="@+id/list" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Диалоги"/><Button android:id="@+id/keys" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Все ключи"/></LinearLayout>
 <dev.themestudio.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="12dp"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="16dp" android:textSize="12sp" android:textColor="#607387"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/undo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Отмена"/><Button android:id="@+id/wallpaper" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Обои"/><Button android:id="@+id/files" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Файл"/></LinearLayout>
</LinearLayout>