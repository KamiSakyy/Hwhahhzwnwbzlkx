<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Свой токен" style="@style/H1"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Настоящий ERC-20 в тестовой сети Sepolia. Бесплатно: нужен только тестовый SepoliaETH на газ. Адресом контракта можно делиться — друзья добавят токен в любой кошелёк." style="@style/Sub"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnFaucet" style="@style/TonalBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:text="Получить бесплатный SepoliaETH" app:icon="@drawable/ic_faucet"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/card_plain" android:orientation="vertical" android:padding="18dp">
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Название токена" android:textColor="#FFFFFF"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etSymbol" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Тикер, например FRND" android:textColor="#FFFFFF"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etSupply" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Количество, например 1000000" android:inputType="number" android:textColor="#FFFFFF"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Input"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDec" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Десятичных знаков (стандарт — 18)" android:inputType="number" android:text="18" android:textColor="#FFFFFF"/></com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnDeploy" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:text="Выпустить токен"/>
<ProgressBar android:id="@+id/prog" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="16dp" android:indeterminateTint="#FFFFFF" android:visibility="gone"/>
<TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_plain" android:lineSpacingMultiplier="1.4" android:padding="16dp" android:textColor="#E5E5E5" android:textIsSelectable="true" android:textSize="13sp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnShare" style="@style/TonalBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Поделиться токеном" android:visibility="gone" app:icon="@drawable/ic_share"/>
</LinearLayout></ScrollView>
