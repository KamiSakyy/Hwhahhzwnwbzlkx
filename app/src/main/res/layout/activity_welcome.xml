<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:orientation="vertical" android:padding="28dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
<ImageView android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/logo_box" android:padding="20dp" android:src="@drawable/ic_logo"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="NOVA WALLET" android:textColor="#FFF" android:textSize="14sp" android:letterSpacing="0.28"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Все ваши активы.\nОдин кошелёк." android:textColor="#FFF" android:textSize="34sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Ethereum  •  Sepolia  •  Base  •  Arbitrum  •  Polygon\nBitcoin  •  Solana  •  DeFi  •  NFT  •  Мессенджер" android:textColor="#6E6E8A" android:textSize="13sp" android:lineSpacingMultiplier="1.5"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCreate" style="@style/PrimaryBtn" android:layout_width="match_parent" android:layout_height="62dp" android:text="Создать кошелёк" android:background="@drawable/btn_primary" android:textColor="#0A0A0C" app:icon="@drawable/ic_add" app:iconTint="#0A0A0C"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnImport" style="@style/GhostBtn" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="12dp" android:text="У меня уже есть кошелёк" android:textColor="#FFF" app:icon="@drawable/ic_key" app:iconTint="#0A0A0C"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:orientation="horizontal"><ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_shield" app:tint="#44445E"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Non-custodial — ключи только на вашем устройстве" android:textColor="#44445E" android:textSize="11sp"/></LinearLayout>
</LinearLayout>
