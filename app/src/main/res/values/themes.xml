<resources>
<style name="Theme.Nova" parent="Theme.Material3.Dark.NoActionBar">
<item name="android:windowBackground">#000000</item><item name="android:fontFamily">sans-serif</item>
<item name="colorPrimary">#FFFFFF</item><item name="colorOnPrimary">#000000</item><item name="colorPrimaryContainer">#242424</item><item name="colorSecondary">#A3A3A3</item>
<item name="colorSurface">#000000</item><item name="colorOnSurface">#FFFFFF</item><item name="colorSurfaceContainer">#121212</item>
<item name="android:statusBarColor">#000000</item><item name="android:navigationBarColor">#000000</item>
<item name="materialButtonStyle">@style/Btn</item>
</style>
<style name="Btn" parent="Widget.Material3.Button"><item name="cornerRadius">999dp</item><item name="android:textAllCaps">false</item><item name="backgroundTint">#FFFFFF</item><item name="android:textColor">#000000</item><item name="iconTint">#000000</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item></style>
<style name="PrimaryBtn" parent="Widget.Material3.Button"><item name="cornerRadius">999dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item><item name="backgroundTint">#FFFFFF</item><item name="android:textColor">#000000</item><item name="iconTint">#000000</item><item name="iconGravity">textStart</item><item name="iconPadding">8dp</item></style>
<style name="TonalBtn" parent="Widget.Material3.Button.TonalButton"><item name="cornerRadius">999dp</item><item name="android:textAllCaps">false</item><item name="backgroundTint">#1F1F1F</item><item name="android:textColor">#FFFFFF</item><item name="iconTint">#FFFFFF</item></style>
